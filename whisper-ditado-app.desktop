[Desktop Entry]
Type=Application
Name=TARS
Comment=Ditado por voz e gravação de reuniões
# binário de release (`pnpm tauri build --no-bundle` em app/); refazer o build se ele sumir
Exec="@PROJECT_ROOT@/app/src-tauri/target/release/whisper-ditado-app"
Icon=@PROJECT_ROOT@/app/src-tauri/icons/128x128.png
Terminal=false
Categories=Utility;
Keywords=TARS;ditado;reunião;transcrição;whisper;
StartupNotify=true
StartupWMClass=whisper-ditado-app
